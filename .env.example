MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=claims_coordinator
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
# Optional
# CLAIM_DAY_MS=20000          # wall ms per simulated claim day
# WORKERS=1                   # 2 shows lease takeover
# LLM_MODE=live|stub          # stub = deterministic offline heuristics (default when no ANTHROPIC_API_KEY)
# DRIFT_AUTO_APPLY_THRESHOLD=0.85
